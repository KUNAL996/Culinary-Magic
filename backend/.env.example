# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:<db_password>@localhost:5432/culinary_magic

# Groq API
GROQ_API_KEY=<my_groq_api_key>
GROQ_MODEL=openai/gpt-oss-20b

# JWT
JWT_SECRET_KEY=<generate_a_random_secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies
COOKIE_SECURE=False
COOKIE_SAMESITE=strict

# CORS
CORS_ORIGINS=http://localhost:4200
